{{!
    @template report_coursemanager/navbar_link

    Icon of the navigation bar linking to the Course Manager dashboard.

    Context variables required for this template:
    * url - String, URL of the dashboard

    Example context (json):
    {
        "url": "https://example.com/report/coursemanager/view.php"
    }
}}

<div class="report-coursemanager-nav-action">
    <a id="report-coursemanager-action" href="{{url}}" class="nav-link icon-no-margin">
        <i class="icon fa fa-list-alt  fa-fw navicon" title="{{#str}} pluginname, report_coursemanager {{/str}}"></i>
    </a>
</div>
